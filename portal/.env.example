# --- Database ---
# App connection: `asv_app` is a NON-superuser, NON-owner role subject to RLS
# (see prisma/migrations/*_rls/migration.sql). The `asv` superuser bypasses RLS
# unconditionally, so tenant DML must never connect as it.
DATABASE_URL="postgresql://asv_app:CHANGE_ME@localhost:5433/asv_portal"
# Admin connection for prisma CLI / migrations (DDL privileges, bypasses RLS).
ADMIN_DATABASE_URL="postgresql://asv:CHANGE_ME@localhost:5433/asv_portal"
APP_MODE="dev"

# --- Keycloak OIDC ---
# Issuer of the Keycloak realm (used to build the OIDC discovery/JWKS URL:
# <issuer>/protocol/openid-connect/certs). Leave unset to disable token
# verification (fails closed with a clear error at call time).
KEYCLOAK_ISSUER="https://keycloak.example.com/realms/asv-portal"
# OIDC confidential-client credentials for the portal (token exchange /
# refresh flows; not yet consumed by header-based verification).
KEYCLOAK_CLIENT_ID="asv-portal"
KEYCLOAK_CLIENT_SECRET="change-me"

# --- Staff identity (prod report attestation / dispute moderation) ---
# In prod, staff = verified Keycloak realm role named by STAFF_ROLE.
# In dev/test only, STAFF_USER_IDS (comma-separated idpIds or emails) also grants staff.
STAFF_ROLE="asv-staff"
STAFF_USER_IDS=""
