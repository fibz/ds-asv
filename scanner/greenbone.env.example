# scanner/greenbone.env.example — copy to scanner/greenbone.env and fill in.
# The script loads it as env DEFAULTS; real environment variables still win.
# $GREENBONE_CONFIG can point at a different config file.
# See scanner/scripts/update_greenbone.py for the full env reference.

# Connection type: ssh (default) | tcp | unix
#   ssh  python-gvm SSHConnection (password auth only) — GREENBONE_SSH_* below
#   tcp  plain GMP over TCP — e.g. an OpenSSH forward of the remote gvmd socket:
#          ssh -fN -L 127.0.0.1:9390:/run/gvmd/gvmd.sock user@gvmd-host
#        then GREENBONE_HOST=127.0.0.1 GREENBONE_PORT=9390
#   unix local gvmd socket (GREENBONE_SOCKET, default /run/gvmd/gvmd.sock)
GREENBONE_CONNECTION=CHANGE_ME
GREENBONE_HOST=CHANGE_ME
GREENBONE_PORT=CHANGE_ME

# SSH login — used only with GREENBONE_CONNECTION=ssh
GREENBONE_SSH_USER=CHANGE_ME
GREENBONE_SSH_PASSWORD=CHANGE_ME
# GREENBONE_SSH_AUTO_ACCEPT=1

# GMP (gvmd) credentials — always required for live fetches
GREENBONE_USER=CHANGE_ME
GREENBONE_PASSWORD=CHANGE_ME

# Cache output (default ./data/greenbone_cves.json)
# GREENBONE_FEED_PATH=./data/greenbone_cves.json

# Local gvmd socket — used only with GREENBONE_CONNECTION=unix
# GREENBONE_SOCKET=/run/gvmd/gvmd.sock